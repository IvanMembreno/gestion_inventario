// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema
// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
    provider     = "prisma-client"
    output       = "../src/generated/prisma"
    moduleFormat = "esm"
}

datasource db {
    provider = "postgresql"
}

// Listas
enum Role {
    ADMIN
    MANAGER
    EMPLOYEE
    VIEWER
}

enum MovementType {
    IN
    OUT
    ADJUSTMENT
}

enum SaleStatus {
    OPEN
    PAID
    CANCELLED
}

enum InvoiceStatus {
    PENDING
    PAID
    CANCELLED
}

// Tablas
model Branch {
    id        String   @id @default(uuid())
    name      String
    address   String?
    isActive  Boolean  @default(true)
    createdAt DateTime @default(now())

    users     User[]
    products  BranchProduct[]
    sales     Sale[]
    movements InventoryMovement[]
}

model User {
    id           String   @id @default(uuid())
    name         String
    email        String   @unique
    passwordHash String
    role         Role     @default(VIEWER)
    isActive     Boolean  @default(true)
    createdAt    DateTime @default(now())

    branch   Branch @relation(fields: [branchId], references: [id])
    branchId String

    movements InventoryMovement[]
    sales     Sale[]
    payments  Payment[]

    @@index([branchId])
}

model Category {
    id          String  @id @default(uuid())
    name        String  @unique
    description String?

    products Product[]
}

model Product {
    id          String   @id @default(uuid())
    name        String
    description String?
    sku         String   @unique
    barcode     String?  @unique
    imageUrl    String?
    createdAt   DateTime @default(now())

    category   Category @relation(fields: [categoryId], references: [id])
    categoryId String

    branches  BranchProduct[]
    movements InventoryMovement[]
    saleItems SaleItem[]

    @@index([categoryId])
}

model BranchProduct {
    id        String   @id @default(uuid())
    stock     Int      @default(0)
    minStock  Int      @default(0)
    price     Decimal  @db.Decimal(10, 2)
    isActive  Boolean  @default(true)
    updatedAt DateTime @updatedAt

    product   Product @relation(fields: [productId], references: [id])
    productId String
    branch    Branch  @relation(fields: [branchId], references: [id])
    branchId  String

    @@unique([productId, branchId])
}

model InventoryMovement {
    id        String       @id @default(uuid())
    type      MovementType
    quantity  Int
    reason    String?
    createdAt DateTime     @default(now())

    branch    Branch  @relation(fields: [branchId], references: [id])
    branchId  String
    product   Product @relation(fields: [productId], references: [id])
    productId String
    user      User    @relation(fields: [userId], references: [id])
    userId    String

    @@index([productId, branchId])
}

model Sale {
    id           String     @id @default(uuid())
    customerName String?
    total        Decimal    @db.Decimal(10, 2) 
    status       SaleStatus @default(OPEN)
    createdAt    DateTime   @default(now())

    branch   Branch @relation(fields: [branchId], references: [id])
    branchId String
    user     User   @relation(fields: [userId], references: [id])
    userId   String

    items   SaleItem[]
    invoice Invoice?

    @@index([userId, branchId])
}

model SaleItem {
    id        String  @id @default(uuid())
    quantity  Int
    unitPrice Decimal @db.Decimal(10, 2)
    subtotal  Decimal @db.Decimal(10, 2)

    sale      Sale    @relation(fields: [saleId], references: [id])
    saleId    String
    product   Product @relation(fields: [productId], references: [id])
    productId String

    @@index([productId])
}

model Invoice {
    id           String        @id @default(uuid())
    customerName String?
    total        Decimal       @db.Decimal(10, 2)
    status       InvoiceStatus @default(PENDING)
    dueDate      DateTime?
    createdAt    DateTime      @default(now())

    sale   Sale   @relation(fields: [saleId], references: [id])
    saleId String @unique

    payments Payment[]

    @@index([customerName])
    @@index([status])
}

model Payment {
    id        String   @id @default(uuid())
    amount    Decimal  @db.Decimal(10, 2)
    createdAt DateTime @default(now())

    user      User    @relation(fields: [userId], references: [id])
    userId    String
    invoice   Invoice @relation(fields: [invoiceId], references: [id])
    invoiceId String

    @@index([invoiceId])
}
